APP_NAME="Luckyu.dev API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=newportfolio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave empty for localhost dev; set to your parent domain in production,
# e.g. .luckyu.dev, so the session cookie is shared between the app
# subdomain and the api subdomain.
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public
MEDIA_DISK=public

# --- Frontend integration (Sanctum SPA + CORS) ---
# Must list every origin the Next.js app is served from.
CORS_ALLOWED_ORIGINS=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000

# --- Seeder-only admin bootstrap account ---
# Change these before running `php artisan db:seed` anywhere but local.
ADMIN_EMAIL=admin@luckyu.dev
ADMIN_PASSWORD=change-this-password

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="hello@luckyu.dev"
MAIL_FROM_NAME="${APP_NAME}"
